---
import { supabase } from '../../../lib/supabase';
import '../../../styles/global.css';

const { slug, id_pedido } = Astro.params;

const { data: tienda } = await supabase
  .from('tiendas')
  .select('id, nombre_tienda, lat_negocio, lng_negocio, es_oculto')
  .eq('slug', slug)
  .single();

if (!tienda) return new Response('Tienda no encontrada', { status: 404 });

const { data: pedido } = await supabase
  .from('pedidos')
  .select('*')
  .eq('id', id_pedido)
  .eq('tienda_id', tienda.id)
  .single();

if (!pedido) return new Response('Pedido no encontrado', { status: 404 });
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rastreo de Pedido | {tienda.nombre_tienda}</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <style>
    .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
    body { font-family: 'Be Vietnam Pro', sans-serif; }

    .status-step { display:flex; flex-direction:column; align-items:center; width:33%; position:relative; z-index:10; }
    .status-icon { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; background-color:#e7e8e9; color:#717973; transition:all 0.4s; border:4px solid #f8f9fa; }
    .status-icon.active { background-color:#10b981; color:white; border-color:#d1fae5; }

    .status-line { position:absolute; top:20px; left:16%; right:16%; height:4px; background-color:#e7e8e9; z-index:0; border-radius:99px; }
    .status-progress { position:absolute; top:0; left:0; height:100%; background:linear-gradient(90deg,#10b981,#34d399); border-radius:99px; transition:width 0.6s ease-in-out; width:0%; }

    .status-text { font-size:11px; font-weight:700; color:#717973; margin-top:8px; text-align:center; }
    .status-text.active { color:#10b981; }

    #leaflet-map { width:100%; height:260px; border-radius:16px; z-index:1; border:1px solid #e2e8f0; }

    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.3)} }
    .live-dot { animation:pulse-dot 1.5s infinite; }
  </style>
</head>
<body class="bg-gray-50 text-gray-900">
  <div class="w-full max-w-[480px] mx-auto min-h-dvh flex flex-col bg-white">

    <header class="p-4 border-b border-gray-100 flex items-center gap-3">
      <a href={`/${slug}`} class="p-2 -ml-2 rounded-full text-gray-600 active:bg-gray-100">
        <span class="material-symbols-outlined">arrow_back</span>
      </a>
      <div>
        <h1 class="font-jakarta text-[18px] font-bold leading-tight text-[#012d1d]">Rastreo de Pedido</h1>
        <p class="text-gray-500 text-[13px]">Pedido #{pedido.id.slice(0,6)}</p>
      </div>
    </header>

    <main class="flex-1 p-4">

      <!-- Timeline -->
      <div class="relative py-6 mb-6">
        <div class="status-line">
          <div id="progress-bar" class="status-progress"></div>
        </div>
        <div class="flex justify-between relative">
          <div class="status-step" id="step-1">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">inventory_2</span></div>
            <span class="status-text">Preparando</span>
          </div>
          <div class="status-step" id="step-2">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">two_wheeler</span></div>
            <span class="status-text">En Camino</span>
          </div>
          <div class="status-step" id="step-3">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">check_circle</span></div>
            <span class="status-text">Entregado</span>
          </div>
        </div>
      </div>

      <!-- Mapa -->
      <div id="map-section" class="mb-6 hidden">
        <div class="flex justify-between items-center mb-2">
          <h3 class="font-jakarta font-bold text-[15px]">Ubicación del Repartidor</h3>
          <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 live-dot inline-block"></span> En Vivo
          </span>
        </div>
        <div id="leaflet-map"></div>
        <p class="text-[12px] text-gray-400 mt-2 text-center">Ubicación GPS actualizada en tiempo real.</p>
      </div>

      <!-- Detalle -->
      <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
        <h3 class="font-jakarta font-bold text-[15px] mb-4">Detalles del Pedido</h3>
        <div class="space-y-3 text-[14px]">
          <div class="flex justify-between">
            <span class="text-gray-500">Cliente:</span>
            <span class="font-semibold text-right">{pedido.nombre_cliente}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Dirección:</span>
            <span class="font-semibold text-right">{pedido.direccion}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Método de Pago:</span>
            <span class="font-semibold text-right">{pedido.metodo_pago}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Estado:</span>
            <span id="label-estado" class="font-bold text-emerald-600">{pedido.estado}</span>
          </div>
          <div class="h-px bg-gray-200 my-2"></div>
          {pedido.items.map((item: any) => (
            <div class="flex justify-between text-[13px]">
              <span>{item.qty}x {item.nombre}</span>
              <span class="font-bold">${(item.qty * item.precio).toLocaleString('es-CO')}</span>
            </div>
          ))}
          <div class="h-px bg-gray-200 my-2"></div>
          <div class="flex justify-between font-bold text-[16px]">
            <span>Total:</span>
            <span class="text-[#012d1d]">${pedido.total.toLocaleString('es-CO')}</span>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script define:vars={{
    pedidoId:      pedido.id,
    initialStatus: pedido.estado,
    createdAt:     pedido.created_at,
    initialLat:    pedido.lat_repartidor,
    initialLng:    pedido.long_repartidor,
    storeLat:      tienda.lat_negocio,
    storeLng:      tienda.lng_negocio,
    supbaseUrl:    import.meta.env.SUPABASE_URL,
    supabaseAnonKey: import.meta.env.SUPABASE_ANON_KEY
  }}>
    let currentStatus = initialStatus;
    let timerInterval = null;
    let pollInterval  = null;
    let map = null;
    let driverMarker = null;

    // Prioridad: 1) GPS repartidor, 2) coordenadas del negocio, 3) Bogotá por defecto
    const fallbackLat = storeLat || 4.6097102;
    const fallbackLng = storeLng || -74.081749;

    // ── Mapa Leaflet ──────────────────────────────────────
    function initMap(lat, lng) {
      if (map) return;
      const tLat = lat || fallbackLat;
      const tLng = lng || fallbackLng;
      map = L.map('leaflet-map').setView([tLat, tLng], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
      }).addTo(map);

      const icon = L.divIcon({
        className: '',
        html: '<div style="background:#10b981;width:36px;height:36px;border-radius:50%;border:3px solid white;box-shadow:0 4px 12px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;"><span style="font-family:\'Material Symbols Outlined\';font-size:18px;color:white;">two_wheeler</span></div>',
        iconSize: [36, 36],
        iconAnchor: [18, 18]
      });
      driverMarker = L.marker([tLat, tLng], { icon }).addTo(map);
    }

    function updateDriverPosition(lat, lng) {
      if (!lat || !lng) return;
      if (!map) { initMap(lat, lng); return; }
      driverMarker.setLatLng([lat, lng]);
      map.panTo([lat, lng]);
    }

    // ── Barra de progreso ───────────────────────────────────
    function updateProgress(estado, lat, lng) {
      if (!estado) return;
      currentStatus = estado;

      const step1Icon   = document.querySelector('#step-1 .status-icon');
      const step2Icon   = document.querySelector('#step-2 .status-icon');
      const step3Icon   = document.querySelector('#step-3 .status-icon');
      const step1Text   = document.querySelector('#step-1 .status-text');
      const step2Text   = document.querySelector('#step-2 .status-text');
      const step3Text   = document.querySelector('#step-3 .status-text');
      const bar         = document.getElementById('progress-bar');
      const mapSection  = document.getElementById('map-section');
      const labelEstado = document.getElementById('label-estado');

      if (labelEstado) labelEstado.innerText = estado;

      if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }

      [step1Icon, step2Icon, step3Icon].forEach(i => i?.classList.remove('active'));
      [step1Text, step2Text, step3Text].forEach(t => t?.classList.remove('active'));

      // Normalizar el estado (sin tildes, minúsculas)
      const s = estado.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      // s ahora puede ser: 'pendiente', 'en preparacion', 'en camino', 'entregado'

      if (s === 'pendiente' || s.includes('preparaci')) {
        step1Icon?.classList.add('active');
        step1Text?.classList.add('active');
        mapSection?.classList.add('hidden');

        // Barra animada: 2 minutos de 5% → 48%
        const start = createdAt ? new Date(createdAt).getTime() : Date.now();
        const dur   = 120_000;
        const tick  = () => {
          const elapsed = Date.now() - start;
          const pct = Math.min(48, Math.max(5, (elapsed / dur) * 50));
          if (bar) bar.style.width = pct + '%';
          if (elapsed >= dur) clearInterval(timerInterval);
        };
        tick();
        timerInterval = setInterval(tick, 1000);

      } else if (s.includes('camino')) {
        step1Icon?.classList.add('active');
        step2Icon?.classList.add('active');
        step2Text?.classList.add('active');
        mapSection?.classList.remove('hidden');
        if (bar) bar.style.width = '55%';

        initMap(lat, lng);
        if (lat && lng) updateDriverPosition(lat, lng);

        let pv = 55;
        timerInterval = setInterval(() => {
          if (pv < 92) { pv++; if (bar) bar.style.width = pv + '%'; }
        }, 3000);

      } else if (s.includes('entregado')) {
        step1Icon?.classList.add('active');
        step2Icon?.classList.add('active');
        step3Icon?.classList.add('active');
        step3Text?.classList.add('active');
        if (bar) bar.style.width = '100%';
        mapSection?.classList.add('hidden');
        clearInterval(pollInterval);

      } else {
        // fallback: cualquier otro estado → paso 1 activo, barra mínima
        step1Icon?.classList.add('active');
        step1Text?.classList.add('active');
        if (bar) bar.style.width = '5%';
      }
    }

    // ── Polling cada 5s ─────────────────────────────────────
    async function fetchStatus() {
      try {
        const r = await fetch(
          `${supbaseUrl}/rest/v1/pedidos?select=estado,lat_repartidor,long_repartidor&id=eq.${pedidoId}&limit=1`,
          { headers: { apikey: supabaseAnonKey, Authorization: 'Bearer ' + supabaseAnonKey, Accept: 'application/json' } }
        );
        const rows = await r.json();
        if (Array.isArray(rows) && rows.length) {
          const { estado, lat_repartidor: lat, long_repartidor: lng } = rows[0];
          if (estado !== currentStatus) {
            updateProgress(estado, lat, lng);
          } else if (lat && lng) {
            updateDriverPosition(lat, lng);
          }
        }
      } catch(e) { console.warn('[Rastreo poll]', e); }
    }

    // ── Arrancar ────────────────────────────────────────────
    updateProgress(initialStatus, initialLat, initialLng);
    pollInterval = setInterval(fetchStatus, 5000);

    window.addEventListener('beforeunload', () => {
      clearInterval(timerInterval);
      clearInterval(pollInterval);
    });
  </script>
</body>
</html>

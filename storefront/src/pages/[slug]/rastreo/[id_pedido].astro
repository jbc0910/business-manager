---
import { supabase } from '../../../lib/supabase';
import '../../../styles/global.css';

const { slug, id_pedido } = Astro.params;

// Fetch store
const { data: tienda } = await supabase
  .from('tiendas')
  .select('id, nombre_tienda')
  .eq('slug', slug)
  .single();

if (!tienda) return new Response('Tienda no encontrada', { status: 404 });

// Fetch order
const { data: pedido } = await supabase
  .from('pedidos')
  .select('*')
  .eq('id', id_pedido)
  .eq('tienda_id', tienda.id)
  .single();

if (!pedido) return new Response('Pedido no encontrado', { status: 404 });
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rastreo de Pedido | {tienda.nombre_tienda}</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
  
  <style>
    .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
    body { font-family: 'Be Vietnam Pro', sans-serif; }
    
    .status-step { display: flex; flex-direction: column; align-items: center; width: 33%; position: relative; z-index: 10; }
    .status-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: #e7e8e9; color: #717973; transition: all 0.3s; border: 4px solid #f8f9fa; }
    .status-icon.active { background-color: #10b981; color: white; }
    
    .status-line { position: absolute; top: 20px; left: 16%; right: 16%; height: 4px; background-color: #e7e8e9; z-index: 0; }
    .status-progress { position: absolute; top: 0; left: 0; height: 100%; background-color: #10b981; transition: width 0.3s; width: 0%; }
    
    .status-text { font-size: 11px; font-weight: 700; color: #717973; margin-top: 8px; text-align: center; }
    .status-text.active { color: #10b981; }

    #map-container { position: relative; width: 100%; height: 250px; background-color: #e2e8f0; border-radius: 16px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    #marker { position: absolute; display: flex; flex-direction: column; align-items: center; transition: all 1s ease-out; }
    .pin { background-color: #3b82f6; width: 24px; height: 24px; border-radius: 50%; border: 3px solid white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
  </style>
</head>
<body class="bg-[#f8f9fa] text-[#191c1d]">
  <div class="w-full max-w-[480px] mx-auto min-h-dvh flex flex-col bg-white">
    
    <header class="p-4 border-b border-gray-100 flex items-center gap-3">
      <a href={`/${slug}`} class="p-2 -ml-2 rounded-full active:bg-gray-100 text-[#414844]">
        <span class="material-symbols-outlined">arrow_back</span>
      </a>
      <div>
        <h1 class="font-jakarta text-[18px] font-bold leading-tight text-[#012d1d]">Rastreo de Pedido</h1>
        <p class="text-[#717973] text-[13px]">Pedido #{pedido.id.slice(0,6)}</p>
      </div>
    </header>

    <main class="flex-1 p-4">
      
      <!-- Timeline -->
      <div class="relative py-6 mb-6">
        <div class="status-line">
          <div id="progress-bar" class="status-progress"></div>
        </div>
        <div class="flex justify-between relative">
          
          <div class="status-step" id="step-1">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">inventory_2</span></div>
            <span class="status-text">Preparando</span>
          </div>
          
          <div class="status-step" id="step-2">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">two_wheeler</span></div>
            <span class="status-text">En Camino</span>
          </div>
          
          <div class="status-step" id="step-3">
            <div class="status-icon"><span class="material-symbols-outlined text-[20px]">check_circle</span></div>
            <span class="status-text">Entregado</span>
          </div>

        </div>
      </div>

      <!-- Map (Simulated) -->
      <div id="map-section" class="mb-6 opacity-0 transition-opacity duration-500 hidden">
        <h3 class="font-jakarta font-bold text-[15px] mb-3">Ubicación del Repartidor</h3>
        <div id="map-container">
          <span class="material-symbols-outlined text-gray-400 text-[64px] absolute opacity-50">map</span>
          <div id="marker">
            <div class="pin"></div>
            <div class="bg-white px-2 py-1 rounded shadow-md mt-1 text-[10px] font-bold text-gray-700 whitespace-nowrap border border-gray-100">Repartidor</div>
          </div>
        </div>
        <p class="text-[12px] text-gray-500 mt-2 text-center">El mapa es una simulación visual para el rastreo.</p>
      </div>

      <!-- Order Details -->
      <div class="bg-[#f8f9fa] rounded-2xl p-4 border border-gray-100">
        <h3 class="font-jakarta font-bold text-[15px] mb-4">Detalles del Pedido</h3>
        
        <div class="space-y-3 text-[14px]">
          <div class="flex justify-between">
            <span class="text-[#717973]">Cliente:</span>
            <span class="font-semibold text-right">{pedido.nombre_cliente}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#717973]">Dirección:</span>
            <span class="font-semibold text-right">{pedido.direccion}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#717973]">Pago:</span>
            <span class="font-semibold text-right">{pedido.metodo_pago}</span>
          </div>
          
          <div class="h-px bg-gray-200 my-2"></div>
          
          {pedido.items.map((item: any) => (
            <div class="flex justify-between text-[13px]">
              <span>{item.qty}x {item.nombre}</span>
              <span class="font-bold">${(item.qty * item.precio).toLocaleString('es-CO')}</span>
            </div>
          ))}
          
          <div class="h-px bg-gray-200 my-2"></div>
          
          <div class="flex justify-between font-bold text-[16px]">
            <span>Total:</span>
            <span class="text-[#012d1d]">${pedido.total.toLocaleString('es-CO')}</span>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script define:vars={{ pedidoId: pedido.id, initialStatus: pedido.estado, initialLat: pedido.lat_repartidor, initialLng: pedido.long_repartidor, supbaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    
    const client = window.supabase.createClient(supbaseUrl, supabaseAnonKey);
    let currentStatus = initialStatus;

    function updateUI(estado, lat, lng) {
      const step1Icon = document.querySelector('#step-1 .status-icon');
      const step1Text = document.querySelector('#step-1 .status-text');
      const step2Icon = document.querySelector('#step-2 .status-icon');
      const step2Text = document.querySelector('#step-2 .status-text');
      const step3Icon = document.querySelector('#step-3 .status-icon');
      const step3Text = document.querySelector('#step-3 .status-text');
      const bar = document.getElementById('progress-bar');
      const mapSection = document.getElementById('map-section');
      const marker = document.getElementById('marker');

      // Reset
      [step1Icon, step2Icon, step3Icon].forEach(i => i.classList.remove('active'));
      [step1Text, step2Text, step3Text].forEach(t => t.classList.remove('active'));

      if (estado === 'En preparación') {
        step1Icon.classList.add('active');
        step1Text.classList.add('active');
        bar.style.width = '0%';
        mapSection.classList.add('hidden');
        mapSection.classList.remove('opacity-100');
      } 
      else if (estado === 'En camino') {
        step1Icon.classList.add('active');
        step2Icon.classList.add('active');
        step2Text.classList.add('active');
        bar.style.width = '50%';
        
        mapSection.classList.remove('hidden');
        setTimeout(() => mapSection.classList.add('opacity-100'), 50);

        // Simulated movement logic for the UI marker
        if (lat && lng) {
          // Normalize lat/lng to percentages for a dummy map box
          // Let's just create a random subtle movement if lat/lng change
          const x = 50 + ((lng % 0.001) * 100000) % 40;
          const y = 50 + ((lat % 0.001) * 100000) % 40;
          marker.style.left = `${x}%`;
          marker.style.top = `${y}%`;
        } else {
          marker.style.left = '50%';
          marker.style.top = '50%';
        }
      } 
      else if (estado === 'Entregado') {
        step1Icon.classList.add('active');
        step2Icon.classList.add('active');
        step3Icon.classList.add('active');
        step3Text.classList.add('active');
        bar.style.width = '100%';
        mapSection.classList.add('hidden');
      }
    }

    // Initial render
    updateUI(initialStatus, initialLat, initialLng);

    // Subscribe to realtime updates
    const channel = client.channel('public:pedidos')
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'pedidos', filter: `id=eq.${pedidoId}` }, payload => {
        const newData = payload.new;
        updateUI(newData.estado, newData.lat_repartidor, newData.long_repartidor);
      })
      .subscribe();
      
  </script>
</body>
</html>
